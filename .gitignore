# --- Secrets: never commit ---
.env
.env.*
!.env.example
*.key
secrets/
credentials/

# --- Local reference clone of upstream PDFMathTranslate (audit only, AGPL-3.0) ---
# Not vendored, not a submodule. See docs/REPO_AUDIT.md Q8.
_reference/

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.pytest_tmp/
.ruff_cache/
*.egg-info/
dist/
build/

# --- Node / frontend ---
node_modules/
frontend/dist/
frontend/.vite/
*.tsbuildinfo

# --- Runtime data: user PDFs, generated PDFs, local DBs ---
# Original PDFs are user data and are never modified; outputs are derived artifacts.
data/
*.db
*.db-wal
*.db-shm
*-mono.pdf
*-dual.pdf
*-translated.pdf
*-bilingual.pdf

# --- Agent scratch (screenshots are large binaries) ---
.agent/screenshots/*
!.agent/screenshots/.gitkeep
.agent/results/*
!.agent/results/.gitkeep

# --- Local scratch that is not part of this product ---
# A separate desktop-pet toy, and page renders of an unrelated deck. Kept on disk,
# never published.
desktop_pet_angelina/
ppt_preview/
ppt_analysis.json

# --- OS / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/

# The agent workspace: task briefs, raw model output, run logs. Not the product,
# and it carries local measurement detail that does not belong in a public tree.
.agent/
