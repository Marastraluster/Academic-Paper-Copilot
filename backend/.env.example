# Academic PDF Copilot — backend configuration template.
#
# Copy to `.env` and edit as needed. `.env` is gitignored and must never be
# committed. Every value below is the built-in default, so an empty file is fine.
#
# Settings precedence: real environment > .env > defaults.

# --- Network -----------------------------------------------------------------
# MUST be a loopback address. The backend refuses to start with anything else
# (127.0.0.1, ::1 or localhost only). This service is local-only by design.
HOST=127.0.0.1
PORT=8000

# --- Storage -----------------------------------------------------------------
# Where the SQLite database lives. Left unset, it defaults to a per-user
# application data directory:
#   Windows: %LOCALAPPDATA%\AcademicPDFCopilot\db.sqlite3
#   other:   ~/.local/share/AcademicPDFCopilot/db.sqlite3
# Parent directories are created automatically.
# DATABASE_PATH=C:\Users\you\AppData\Local\AcademicPDFCopilot\db.sqlite3

# --- Logging -----------------------------------------------------------------
# One of: CRITICAL, ERROR, WARNING, INFO, DEBUG
LOG_LEVEL=INFO

# --- CORS --------------------------------------------------------------------
# Comma-separated exact origins of the local frontend. A wildcard "*" is
# rejected at startup — it would defeat the loopback-only guarantee.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# --- Development -------------------------------------------------------------
# Enables the interactive API docs at /docs. Leave off in normal use.
DEBUG=false
